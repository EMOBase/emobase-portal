---
import Layout from "./default.astro";
import BlankLayout from "./blank.astro";
import AdminLogin from "../components/layouts/AdminLogin/index.tsx";
import SessionManager from "../components/layouts/SessionManager";
import Toaster from "../components/ui/toaster.tsx";

interface Props {
  title?: string;
}

const { title = "Admin - EMOBase" } = Astro.props;
const { user, session } = Astro.locals;
---

{
  user && session && !session.error ? (
    <Layout title={title}>
      <script is:inline define:vars={{ session }}>
        window.__SESSION__ = session;
      </script>
      <SessionManager client:load />
      <slot />
      <div class="h-8" aria-hidden="true"></div>
      <Toaster client:load />
    </Layout>
  ) : (
    <BlankLayout>
      <AdminLogin client:load />
    </BlankLayout>
  )
}
