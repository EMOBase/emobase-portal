---
import Layout from "../layouts/default.astro";
import HomePage from "../components/pages/home/index.tsx";
import genomicsService from "@/utils/services/genomics";
import { getCurrentVersionName } from "@/utils/currentVersion";

const { fetchVersionDetail } = genomicsService();

let assemblies: any[] = [];

try {
  const currentVersionName = await getCurrentVersionName();

  if (currentVersionName) {
    const detail = await fetchVersionDetail(currentVersionName);
    assemblies = detail.data.assemblies || [];
  }
} catch (e) {
  console.error("Failed to fetch assemblies:", e);
  assemblies = [];
}
---

<Layout title="EMOBase - Discover the Blueprint of Life">
  <HomePage assemblies={assemblies} client:load />
</Layout>
