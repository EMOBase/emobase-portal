---
import AdminLayout from "../layouts/admin.astro";
---

<AdminLayout>
  <main class="flex-grow">
    <section class="max-w-4xl mx-auto px-4 py-20 text-center">
      <h1
        class="text-3xl md:text-4xl font-display font-bold text-slate-800 tracking-tight mb-2"
      >
        Admin
      </h1>
      <p class="text-slate-500 leading-relaxed max-w-xl mx-auto">
        This is where admin tools for EMOBase will live. For now it is a
        placeholder page to demonstrate the fake server-side session before
        swapping to Keycloak or a server-side API.
      </p>
    </section>
  </main>
</AdminLayout>
